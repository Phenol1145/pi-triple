{
  "name": "@away_from/pi-triple",
  "version": "0.8.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "ptl": "./packages/framework/dist/pit.js"
  },
  "files": [
    "dist",
    "extensions",
    "docs/ptl/templates",
    "README.md",
    "packages/*/dist/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist packages/shared/dist packages/infra/dist packages/framework/dist packages/mailbox/dist packages/extensions-in-container/dist",
    "build": "tsc -p packages/shared && tsc -p packages/infra && tsc -p packages/framework && tsc -p packages/mailbox && tsc -p packages/extensions-in-container && tsc -p tsconfig.json",
    "pth:dev": "tsx watch src/pth/main.ts",
    "pth:start": "node dist/pth/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc -p packages/shared --noEmit && tsc -p packages/framework --noEmit",
    "monitor": "node tools/docker-monitor/server.js",
    "ptl:dev": "tsx packages/framework/src/pit.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@fastify/websocket": "^11.0.0",
    "@sinclair/typebox": "^0.34.52",
    "bullmq": "^5.0.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0",
    "ink": "^5.2.1",
    "ioredis": "^5.4.0",
    "pg": "^8.22.0",
    "prom-client": "^15.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "zod": "^4.0.0",
    "@away_from/infra": "file:packages/infra",
    "@away_from/shared": "file:packages/shared"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
