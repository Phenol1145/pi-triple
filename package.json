{
  "name": "@away_from/pi-triple",
  "version": "1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "ptl": "./packages/framework/dist/pit.js"
  },
  "files": [
    "dist",
    "extensions",
    "docs/ptl/templates",
    "README.md",
    "packages/*/dist/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist packages/shared/dist packages/infra/dist packages/framework/dist packages/pth-console/dist packages/mailbox/dist packages/dev-container/dist packages/pth-memory/dist packages/pth-sandbox/dist",
    "build": "tsc -p packages/shared && tsc -p packages/infra && tsc -p packages/pth-memory && tsc -p packages/pth-sandbox && tsc -p packages/pth-console && tsc -p packages/framework && npm run build:web -w @away_from/pth-console && node scripts/copy-framework-web-assets.mjs && tsc -p packages/mailbox && tsc -p packages/dev-container && tsc -p tsconfig.json",
    "pth:dev": "tsx watch src/pth/main.ts",
    "pth:start": "node dist/pth/main.js",
    "adjudicate": "node --experimental-strip-types scripts/adjudicate-tensions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:sandbox-build": "bash scripts/verify-clean-sandbox-build.sh",
    "lint": "tsc -p packages/shared && tsc -p packages/infra && tsc -p packages/pth-memory && tsc -p packages/pth-sandbox && tsc -p packages/pth-console && tsc --noEmit && tsc -p packages/shared --noEmit && tsc -p packages/framework --noEmit && npm run check:pth-boundaries && npm run check:pth-config && npm run check:product-boundaries",
    "monitor": "node deploy/docker-monitor/server.js",
    "ptl:dev": "tsx packages/framework/src/pit.ts",
    "ext:check": "tsx scripts/ext-check.ts",
    "check:pth-boundaries": "tsx scripts/check-pth-boundaries.ts",
    "check:pth-config": "tsx scripts/check-pth-config.ts",
    "check:product-boundaries": "tsx scripts/check-product-boundaries.ts",
    "pth": "tsx scripts/pth-cli.ts"
  },
  "dependencies": {
    "@away_from/infra": "file:packages/infra",
    "@away_from/pth-memory": "file:packages/pth-memory",
    "@away_from/pth-sandbox": "file:packages/pth-sandbox",
    "@away_from/shared": "file:packages/shared",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@fastify/websocket": "^11.0.0",
    "@sinclair/typebox": "^0.34.52",
    "bullmq": "^5.0.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0",
    "ink": "^5.2.1",
    "ioredis": "^5.4.0",
    "pg": "^8.22.0",
    "prom-client": "^15.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@away_from/dev-container": "file:packages/dev-container",
    "@away_from/mailbox": "file:packages/mailbox",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
