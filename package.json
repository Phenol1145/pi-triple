{
  "name": "pi-triple",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "pit": "./dist/ptl/pit.js",
    "pth": "./dist/pth/main.js"
  },
  "files": [
    "dist",
    "extensions",
    "docs/ptl/templates",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "pit:dev": "tsx src/ptl/pit.ts",
    "pth:dev": "tsx watch src/pth/main.ts",
    "pth:start": "node dist/pth/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "monitor": "node tools/docker-monitor/server.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@fastify/websocket": "^11.0.0",
    "@sinclair/typebox": "^0.34.52",
    "bullmq": "^5.0.0",
    "chokidar": "^4.0.0",
    "cli-highlight": "^2.1.11",
    "crypto-js": "^4.2.0",
    "fastify": "^5.0.0",
    "ink": "^5.2.1",
    "ioredis": "^5.4.0",
    "marked": "^15.0.12",
    "pg": "^8.22.0",
    "pino": "^9.0.0",
    "prom-client": "^15.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
