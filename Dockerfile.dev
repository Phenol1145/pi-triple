# Dev 镜像（开发模式——tsx watch 热重启——基于生产镜像 + devDeps）
# 生产镜像 omit=dev（无 tsx/typescript）——dev 镜像补全量依赖
FROM pi-platform-pi-platform:latest

USER root
WORKDIR /app

# devDeps 安装（tsx/typescript 等——生产镜像 omit=dev 缺失）
# manifest 复用生产镜像的（已 COPY）——只需 npm ci 全量
RUN npm ci

USER node

# 启动命令在 docker-compose.dev.yaml 覆盖（tsx watch src/pth/main.ts）
