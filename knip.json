{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/pth/main.ts",
    "src/sandbox/main.ts",
    "src/pth/kernel/execution/batch-process.ts",
    "packages/framework/src/**/*.ts",
    "test/**/*.test.ts",
    "scripts/*.ts"
  ],
  "project": ["src/**/*.ts", "packages/framework/src/**/*.ts"],
  "ignore": ["archive/**", "extensions/**", "toolstore/**", "docs/**", "skills-store/**"],
  "ignoreBinaries": ["pit", "ptl"],
  "ignoreExportsUsedInFile": true
}
